# IBVAP Backend Environment Template
PROJECT_NAME="IBVAP - Intelligent Border Video Analytics Platform"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"

DATABASE_URL="sqlite:///./data/ibvap.db"

SECRET_KEY="replace-with-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

DATA_DIR="./data"
EVIDENCE_DIR="./data/evidence"
CROSSINGS_DIR="./data/vehicle_crossings"
UPLOADS_DIR="./data/uploads"
AI_CORE_DIR="../OutLiners_SIH"
